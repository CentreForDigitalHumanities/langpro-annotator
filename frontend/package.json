{
  "name": "langpro-annotator",
  "version": "0.5.0",
  "scripts": {
    "start": "yarn serve",
    "build": "ng build",
    "watch": "ng build --watch",
    "test": "ng test --watch=true",
    "serve:ssr:langpro-annotator": "node dist/langpro-annotator/server/server.mjs",
    "prebuild": "node ./build/build-pre.js",
    "i18n": "ng extract-i18n --output-path locale",
    "preserve": "yarn prebuild",
    "serve": "ng serve",
    "serve:en": "ng serve --configuration=en",
    "serve:nl": "ng serve --configuration=nl",
    "stop": "lsof -t -i tcp:4200 | xargs kill -9 || echo \"not running\"",
    "pretest": "yarn prebuild",
    "test-once": "ng test --watch=false"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-server": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/ssr": "^21.2.27",
    "@fortawesome/angular-fontawesome": "^5.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "colors": "^1.4.0",
    "express": "^4.18.2",
    "rxjs": "~7.8.0",
    "svg-pan-zoom": "bumbu/svg-pan-zoom",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/localize": "21.2.25",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.18.0",
    "jsdom": "^30.1.3",
    "ng-extract-i18n-merge": "^3.5.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
