FROM node:24.14-slim AS builder

# Accept version as build argument
ARG APP_VERSION=0.0.0
ARG SOURCE_URL=unknown

# Install git for pre-build.js
RUN apt-get update
RUN apt-get install -y git

# Set the working directory.
WORKDIR /usr/src/app

# Copy app dependencies
COPY package.json yarn.lock ./

# Install app dependencies
RUN yarn install

# Copy app source
COPY . /usr/src/app

# Set version as environment variable for build scripts
ENV APP_VERSION=${APP_VERSION}
ENV SOURCE_URL=${SOURCE_URL}

# Pre-build
RUN npm run prebuild

# Build app
RUN npm run build -- --output-path=./dist/out --configuration production

# Setup NGINX to serve the app.
FROM nginx:alpine

# Copy the built app to the NGINX server.
COPY --from=builder /usr/src/app/dist/out/browser /usr/share/nginx/html

# Copy the NGINX configuration file.
COPY ./nginx.conf /etc/nginx/conf.d/default.conf

# Expose port for the NGINX server.
EXPOSE 4200
